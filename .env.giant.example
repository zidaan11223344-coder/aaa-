# =========================================================
# Giant Chat bot from repository aaa-
# Platform: https://console.altare.gg
# Copy this file to .env or add the same variables in Altare Variables.
# Never publish real passwords or tokens in GitHub.
# =========================================================

# Run the original Giant bot in aaa-/bot.py.
# Use alsfer so this service is not the merged Talkin service.
BOT_MODE=alsfer

# Giant account credentials
BOT_ID=PUT_GIANT_BOT_USERNAME_HERE
BOT_PWD=PUT_GIANT_BOT_PASSWORD_HERE
BOT_PASSWORD=PUT_GIANT_BOT_PASSWORD_HERE
BOT_MASTER=PUT_MASTER_USERNAME_HERE

# Room to join automatically
GROUP_TO_JOIN=PUT_ROOM_NAME_HERE
AUTO_JOIN_ALL_ROOMS=1
JOIN_ALL_ROOMS=1

# Public media server. Altare should provide this domain/URL.
# Example: https://YOUR-SERVICE.altare.gg
PUBLIC_MEDIA_URL=https://YOUR-SERVICE.altare.gg
PUBLIC_BASE_URL=https://YOUR-SERVICE.altare.gg
GIFT_PUBLIC_BASE_URL=https://YOUR-SERVICE.altare.gg

# Runtime server
PORT=8080
ASSET_HTTP_PORT=8080
ASSET_HTTP_ENABLED=1

# Persistent storage. Mount an Altare volume at /app/data if supported.
BOT_DATA_DIR=/app/data
PERSISTENT_DATA_DIR=/app/data
BOT_ASSETS_DIR=/app/assets

# Recommended runtime defaults
VERIFICATION_ENABLED=on
MUSIC_MAX_SECONDS=900
MUSIC_COOLDOWN=15
BILLION_GAME_COOLDOWN_SECONDS=60
QUIET_MODE=1
LOG_ROOM_MESSAGES=0

# Optional media/search variables
YOUTUBE_COOKIES=
YOUTUBE_COOKIES_FILE=
PIPED_APIS=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional Telegram diagnostics; leave empty if unused.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SECRET_CHAT_ID=

# Optional GitHub JSON backup; leave disabled unless intentionally configured.
GITHUB_SYNC=0
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_TOKEN=
